# Glyph environment template. Copy to .env.local and fill in as needed.
# .env.local is gitignored; .env.template is safe to commit.

# ---------------------------------------------------------------------------
# Feature flags (optional — all default to sensible values in
# src/lib/feature-flags.ts). Any NEXT_PUBLIC_* value is exposed to the browser.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_FLAG_SYNC_ENABLED=false
# NEXT_PUBLIC_FLAG_AUTH_REQUIRED=false
# NEXT_PUBLIC_FLAG_LIBRARY_SEARCH_ENABLED=true
# NEXT_PUBLIC_FLAG_READER_PROGRESS_UNIFIED=true
# NEXT_PUBLIC_FLAG_PDF_SELECTION_MAPPING_V2=true
# NEXT_PUBLIC_FLAG_TEXTREADER_TOPBAR_SPEEDREAD_ENABLED=true
# NEXT_PUBLIC_FLAG_GOAL_BASED_READING=true

# ---------------------------------------------------------------------------
# AI features (optional)
# Glyph uses a BYOK (bring-your-own-key) model: users paste an Anthropic API
# key into Settings inside the app, which is stored in localStorage on their
# device. No server-side AI key is required for the current web build.
# ---------------------------------------------------------------------------
