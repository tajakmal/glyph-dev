# CLAUDE
AGENT=claude
MAX_ITERATIONS=3
MODEL=opus
YOLO_MODE=true

# =============================================================================
# Multi-Task Mode
# =============================================================================
# Process task queue from tasks directory instead of single RALPH_TASK.md
# Options: true, false
TASK_MODE=true

# Directory containing task files (used when TASK_MODE=true)
TASKS_DIR=ralph/tasks

# Skip failed tasks and continue to next (instead of stopping)
# Options: true, false
CONTINUE_ON_FAILURE=true




