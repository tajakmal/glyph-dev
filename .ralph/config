# =============================================================================
# Ralph Configuration
# =============================================================================
# Uncomment and modify options as needed. CLI flags override these values.

# =============================================================================
# Agent Selection
# =============================================================================
# Which CLI to use for the autonomous loop
# Options: claude, codex
# AGENT=claude

# =============================================================================
# Iteration Control
# =============================================================================
# Maximum iterations before stopping (per task in multi-task mode)
# SINGLE_ITERATION overrides this to 1 when true
# MAX_ITERATIONS=3

# Run only one iteration then stop (useful for testing)
# Options: true, false
# SINGLE_ITERATION=false

# =============================================================================
# Model Selection
# =============================================================================
# Model to use (passed to the CLI). Leave empty for CLI default.
#
# Claude models:
#   Aliases: sonnet, opus, haiku
#   Full names: claude-sonnet-4-5-20250929, claude-opus-4-5-20251101, etc.
#
# Codex models:
#   Set in ~/.codex/config.toml or use: o3, gpt-5.2-codex, etc.
#
# MODEL=opus

# =============================================================================
# Permission Mode
# =============================================================================
# Skip all permission prompts (autonomous mode)
# Options: true, false
# WARNING: Allows agent to run any command without approval
# YOLO_MODE=true

